{
  "name": "librum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "staging:fixtures:seed": "node --experimental-strip-types --env-file=.env.staging.local scripts/staging-fixtures/seed.mts",
    "staging:fixtures:reset": "node --experimental-strip-types --env-file=.env.staging.local scripts/staging-fixtures/reset.mts reset-to-baseline",
    "staging:fixtures:teardown": "node --experimental-strip-types --env-file=.env.staging.local scripts/staging-fixtures/reset.mts teardown"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.20.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
