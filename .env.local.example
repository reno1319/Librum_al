# Copy this file to .env.local and fill in the values below.

# Supabase project: Dashboard > Project Settings > API.
# Must be an isolated, non-production Supabase project you control --
# never the production project. A repository-level guard
# (src/lib/supabase/env-guard.ts, see ROADMAP.md Phase 1) refuses to
# construct any Supabase client anywhere outside a genuine Vercel
# Production execution if this resolves to the production project ref.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (same page as above, "service_role" secret).
# Server-only — never expose this to the browser. Used by trusted
# server-only code that must bypass row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute links (checkout return URLs, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Resend API key for purchase receipt / sale notification
# emails (Dashboard > API Keys at resend.com). Leave blank to skip
# emails entirely — nothing else breaks without it.
RESEND_API_KEY=

# Optional: defaults to Resend's shared test address if unset, which
# only delivers to the email you signed up to Resend with. See README
# for how to send to arbitrary addresses (verify your own domain).
# EMAIL_FROM=Librum <onboarding@resend.dev>

# Shared secret for the scheduled POST /api/internal/payouts/run job
# (vercel.json). Any request without an exact
# `Authorization: Bearer <this value>` header is rejected.
CRON_SECRET=

# Optional: "Under construction" page (src/lib/site-lock.ts). While set,
# every visitor sees that page; /unlock?key=<this value> lets one browser
# in for 30 days. Must be 32+ characters or the unlock link refuses to
# work. Leave unset locally; on Vercel set it for Production only, and
# delete it (then redeploy) to take the page down.
# SITE_LOCK_KEY=

# PAID-MODE-1: the two provider-neutral paid-mode capabilities. Both are
# server-only (deliberately no NEXT_PUBLIC_ prefix), and each accepts
# exactly one value, matched case-sensitively and untrimmed — anything
# else, including unset, empty, wrongly-cased or whitespace-padded,
# denies. They are independent: neither value enables the other
# capability, and a value pasted into the wrong variable enables nothing.
#
# Both are recognised ONLY on the exact protected staging deployment
# (Vercel Preview, branch `staging`, staging Supabase project). Setting
# either anywhere else — Production above all — enables nothing, and
# NEITHER MAY EVER BE CREATED IN PRODUCTION. Leave both unset locally.
#
# PAID_PUBLISHING_MODE=controlled_staging_publishing_test
# PAID_CHECKOUT_MODE=controlled_staging_checkout_test
