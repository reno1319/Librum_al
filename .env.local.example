# Copy this file to .env.local and fill in the values below.

# Supabase project: Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (same page as above, "service_role" secret).
# Server-only — never expose this to the browser. Used by the Stripe
# webhook to record a purchase, bypassing row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test keys: Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (Stripe CLI) while developing locally — see README for details.
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe's redirect-back URLs after checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Added in a later phase (author payouts). Not needed yet.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
