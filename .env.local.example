# Copy this file to .env.local and fill in the values below.

# Supabase project: Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (same page as above, "service_role" secret).
# Server-only — never expose this to the browser. Used by the Stripe
# webhook to record a purchase, bypassing row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test keys: Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (Stripe CLI) while developing locally — see README for details.
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe's redirect-back URLs after checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Resend API key for purchase receipt / sale notification
# emails (Dashboard > API Keys at resend.com). Leave blank to skip
# emails entirely — nothing else breaks without it.
RESEND_API_KEY=

# Optional: defaults to Resend's shared test address if unset, which
# only delivers to the email you signed up to Resend with. See README
# for how to send to arbitrary addresses (verify your own domain).
# EMAIL_FROM=Librum <onboarding@resend.dev>

# Added in a later phase (author payouts). Not needed yet.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# LAUNCH-1 P1-8: shared secret for POST /api/internal/reconcile-transfer-
# reversals (automatic lost-dispute transfer-reversal recovery). Any
# request without an exact `Authorization: Bearer <this value>` header
# is rejected. No scheduler is configured in this repository yet -- see
# the Migration 036 implementation report for what triggers this route
# in production and how it should be scheduled.
CRON_SECRET=
