{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // PHASE-1C: scripts/staging-fixtures/*.mts import each other (and
    // one app module, src/lib/supabase/env-guard.ts) via explicit
    // relative .mts/.ts extensions -- required for those files to run
    // directly under plain `node --experimental-strip-types` with no
    // bundler (see scripts/staging-fixtures/README.md). Permissive
    // only: requires noEmit (already set above) and does not change
    // how any EXISTING extensionless import elsewhere in this repo is
    // type-checked.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
